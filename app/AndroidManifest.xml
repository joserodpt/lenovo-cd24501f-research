<?xml version="1.0" encoding="utf-8"?>
<!--
  Device Diag: a dense, read-only device-info dashboard for the CD-24501F (and a handy first app
  to prove the offline userdata route works end to end). It also visualises touch input and lists
  input / USB devices.

  package MUST match the <package> entry you add to packages.xml. All permissions are "normal".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.diag"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="27" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <application
        android:label="Device Diag"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode|density|fontScale">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Make it the home screen on Android Things -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.IOT_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
